# =============================================================================
# FOUNDRY — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before running.

# Database (Turso)
# Provision at https://turso.tech — create a database, get URL and auth token
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication (Clerk)
# Create app at https://clerk.com — get keys from dashboard
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# GitHub OAuth
# Create OAuth App at https://github.com/settings/developers
# Callback URL: {APP_URL}/onboarding/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# NOTE: Foundry ingests GitHub data by polling (see services/integration/github.ts),
# not via inbound webhooks. There is no x-hub-signature-256 verifier and no
# GitHub webhook route mounted, so GITHUB_WEBHOOK_SECRET is intentionally absent.
# If an inbound GitHub webhook is ever added, verify signatures with
# crypto.timingSafeEqual (see the Clerk handler in routes/auth/clerk.ts).

# AI (OpenRouter — primary)
# Get API key at https://openrouter.ai/keys
# Routes all LLM calls (Claude, GPT, etc.) through OpenRouter for cost efficiency.
# Falls back to ANTHROPIC_API_KEY if set (backward compatible).
OPENROUTER_API_KEY=sk-or-v1-...

# AI (Anthropic — optional fallback)
# Only needed if not using OpenRouter. OpenRouter is preferred.
# ANTHROPIC_API_KEY=sk-ant-...

# Email (Resend)
# Create account at https://resend.com — verify domain
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=foundry@yourdomain.com

# Payments (Stripe)
# Create account at https://stripe.com — create products and prices
# Tiers: Solo ($79/mo), Growth ($199/mo), Investor-Ready ($399/mo)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_INVESTOR_READY_PRICE_ID=price_...

# Ecosystem Integration
# Shared secret for internal API routes between Foundry, Koldly, AcreOS, Apex Micro
ECOSYSTEM_SERVICE_KEY=your-ecosystem-service-key
KOLDLY_INTERNAL_API_URL=https://koldly.yourdomain.com

# Encryption
# 32-byte hex key for AES-256-GCM envelope encryption of tokens/credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-string

# Application
APP_URL=http://localhost:8080
NODE_ENV=development
