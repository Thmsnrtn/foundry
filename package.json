{
  "name": "foundry",
  "version": "0.1.0",
  "description": "Autonomous business intelligence platform for SaaS founders",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && tsc && tsc-alias && mkdir -p dist/public && cp -r src/public/. dist/public/ && mkdir -p dist/db/migrations && cp -r src/db/migrations/. dist/db/migrations/",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "migrate": "tsx src/cli/index.ts db:migrate",
    "seed": "tsx src/cli/index.ts db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:evals": "vitest --run tests/evals",
    "ratchet": "node scripts/ratchet.mjs",
    "lint:columns": "node scripts/check-insert-columns.mjs && node scripts/check-sql-columns.mjs && node scripts/check-select-columns.mjs && node scripts/check-test-schema-fabrication.mjs && node scripts/check-check-vocabularies.mjs && node scripts/audit-unauthorized-votes.mjs && node scripts/check-autonomous-approval.mjs",
    "lint:ai-attribution": "node scripts/check-ai-attribution.mjs",
    "check": "npm run typecheck && npm run ratchet && npm run kernel:boundary && npm run guards:nullsafe && npm run truth:audit && npm run effects:audit && npm run test:ci",
    "kernel:boundary": "node scripts/check-kernel-boundary.mjs",
    "truth:audit": "node scripts/audit-public-claims.mjs",
    "sim:walkthrough": "TURSO_DATABASE_URL=file::memory: tsx tests/simulation/walkthrough.ts",
    "sim:golden": "TURSO_DATABASE_URL=file::memory: tsx tests/simulation/golden-output.ts",
    "sim:golden:ai": "TURSO_DATABASE_URL=file::memory: tsx tests/simulation/golden-output-ai.ts",
    "load:crons": "TURSO_DATABASE_URL=file::memory: tsx tests/load/cron-load.ts",
    "mcp:context": "tsx src/mcp/cli.ts context",
    "mcp:audit": "tsx src/mcp/cli.ts audit",
    "mcp:issues": "tsx src/mcp/cli.ts issues",
    "mcp:dna": "tsx src/mcp/cli.ts dna",
    "effects:audit": "node scripts/audit-consequential-effects.mjs",
    "guards:nullsafe": "node scripts/check-guard-null-safety.mjs"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.13.0",
    "@hono/node-server": "^1.19.9",
    "@libsql/client": "^0.5.0",
    "@sentry/node": "^8.47.0",
    "commander": "^12.0.0",
    "cron": "^3.1.0",
    "hono": "^4.0.0",
    "nanoid": "^5.0.0",
    "resend": "^3.0.0",
    "stripe": "^14.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
